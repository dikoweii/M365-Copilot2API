[Unit]
Description=M365 Copilot2API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=m365-copilot2api
Group=m365-copilot2api
WorkingDirectory=/opt/m365-copilot2api/current
ExecStart=/opt/m365-copilot2api/current/m365-copilot2api
Environment=M365_LISTEN=127.0.0.1:4141
Environment=M365_DATA_DIR=/var/lib/m365-copilot2api
Environment=M365_API_KEYS=/var/lib/m365-copilot2api/api-keys.json
Environment=M365_ADMIN_PASSWORD_FILE=/var/lib/m365-copilot2api/admin-password
StateDirectory=m365-copilot2api
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/m365-copilot2api

[Install]
WantedBy=multi-user.target
